NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Browser map key: restrict to Clarifi production/preview domains and Maps JavaScript API.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# Server-side routing/geocoding key. Do not expose with NEXT_PUBLIC_.
MAPQUEST_API_KEY=

# Provider adapters (configure when selected)
EMAIL_PROVIDER=adapter_pending
EMAIL_API_KEY=
SMS_PROVIDER=
SMS_API_KEY=
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=

# Customer estimate delivery. Sender must be authenticated by the selected email provider before production sending.
QUOTE_SENDER_NAME=Clarifi
QUOTE_SENDER_EMAIL=quoteunquoteapp@gmail.com

# Temporary organization communication defaults
INQUIRY_EMAIL=quoteunquoteapp@gmail.com
LEAD_NOTIFICATION_EMAIL=quoteunquoteapp@gmail.com
QUOTE_REPLY_TO_EMAIL=quoteunquoteapp@gmail.com

# Server/Edge only. Never expose with NEXT_PUBLIC_ or ship in Expo.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Approval-link email sending (optional). When set, the office can email
# estimate approval links directly from the Review stage (Resend).
# Without it, the UI falls back to copy-link.
RESEND_API_KEY=<redacted>

# Public site origin used to build approval links in emails.
NEXT_PUBLIC_SITE_URL=https://www.yavamo.ca

# Payment provider for deposits (not connected yet — stubbed).
# Set PAYMENT_PROVIDER=stripe and PAYMENT_SECRET_KEY when ready.
